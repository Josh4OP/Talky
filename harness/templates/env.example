# Copia este archivo como .env y completa los valores. NUNCA subas .env a git.

# --- Groq (transcripción y LLM) ---
GROQ_API_KEY=
# Uno o varios modelos separados por coma. Verifica los nombres vigentes en https://console.groq.com/docs/models
GROQ_MODEL=
GROQ_WHISPER_MODEL=whisper-large-v3

# --- Opcionales ---
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_MODEL=

# Quién sintetiza los análisis: groq, gemini, ollama o groq:<modelo>
JUDGE_PROVIDER=groq
MIN_MODELS_OK=1

# --- Transcripción ---
# auto: Groq si hay clave y respaldo local; groq: solo Groq; local: solo faster-whisper
TRANSCRIBER=auto
WHISPER_MODEL=small

# --- Límites ---
MAX_TRANSCRIPT_CHARS=12000
MAX_UPLOAD_MB=100
MAX_DURATION_S=2700
MIN_DURATION_S=5

# --- Etapas opcionales ---
ENABLE_VERIFIER=true
ENABLE_TEXT_EMBEDDINGS=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ENABLE_EVENT_CLASSIFIER=false
EVENT_MODEL_PATH=models/event_classifier.joblib

# --- Servidor ---
DB_PATH=talky.db
# En producción restringe los orígenes, por ejemplo https://mi-app.example
CORS_ORIGINS=*

# --- Sesión ---
# header: identidad declarada con X-User-Id (desarrollo y pruebas); jwt: token de dispositivo firmado (la app)
AUTH_MODE=header
# Obligatorio con AUTH_MODE=jwt: al menos 32 caracteres aleatorios. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_DAYS=30
